# Public mobile configuration. EXPO_PUBLIC_ values are embedded in the Expo bundle.

# Canonical FateDrop Signal Engine used for Search, catalogue and True Price.
EXPO_PUBLIC_SIGNAL_ENGINE_URL=https://fatedrop-cloud-production.up.railway.app

# Transitional app API for local/demo routes that have not moved into FateDrop Cloud yet.
# Use your development machine's LAN address while running the legacy server locally.
EXPO_PUBLIC_APP_API_BASE_URL=http://192.168.1.100:3000

# Backward-compatible legacy variable. Prefer EXPO_PUBLIC_APP_API_BASE_URL for new setups.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:3000

# Server-only examples for future hosted adapters. Never prefix secrets with EXPO_PUBLIC_.
# SHOPIFY_STOREFRONT_TOKEN=
# WOOCOMMERCE_CONSUMER_KEY=
# WOOCOMMERCE_CONSUMER_SECRET=
